{
  "name": "angaza-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first sandbox for particle simulations",
  "main": "./out/main/index.js",
  "desktopName": "angaza-sandbox.desktop",
  "author": "Angaza",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "oxlint src tests",
    "dist": "npm run build && electron-builder --linux AppImage",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
